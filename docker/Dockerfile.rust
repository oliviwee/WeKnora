# syntax=docker/dockerfile:1

FROM rust:1.95-slim-bookworm AS builder

WORKDIR /workspace

COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/weknora-rust ./rust/weknora-rust

RUN cargo build --release --locked --manifest-path rust/Cargo.toml

FROM debian:12.12-slim

RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY --from=builder /workspace/rust/target/release/weknora-rust /usr/local/bin/weknora-rust

ENV WEKNORA_SERVER_HOST=0.0.0.0 \
    WEKNORA_SERVER_PORT=8080 \
    WEKNORA_HEALTHCHECK_HOST=127.0.0.1

EXPOSE 8080

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
  CMD ["/usr/local/bin/weknora-rust", "--healthcheck"]

CMD ["/usr/local/bin/weknora-rust"]
